#include <idc.idc>

// =============================================================
// D2Client.idc  --  generated by gen_ida_idc_types.ps1 (D2MOO)
// Renames functions via set_name() using base + RVA.
// 65 names extracted from D2Client headers.
//
// TARGET: IDA process dump
// Finds the DLL base by scanning IDA segments for name containing
// "D2Client" -- no hardcoded address needed.
//
// IDA 6.x: replace  set_name(a,n,0x880)  with  MakeNameEx(a,n,0x800)
// =============================================================

static Apply_D2Client()
{
    // --- Find module base via segment name ---
    auto base = BADADDR;
    auto seg;
    for (seg = FirstSeg(); seg != BADADDR; seg = NextSeg(seg)) {
        if (strstr(get_segm_name(seg), "D2Client") != -1) {
            base = SegStart(seg);
            break;
        }
    }
    if (base == BADADDR) {
        Message("[D2Client] ERROR: no segment with name containing 'D2Client'.\n");
        return;
    }
    Message("[D2Client] base=0x%X\n", base);

    auto renamed = 0;
    auto skipped = 0;

    if (set_name(base + 0xBF80, "GAME_GetFrame", 0x880)) renamed++; else skipped++;
    if (set_name(base + 0xC0805, "D2CLIENT_sprintf", 0x880)) renamed++; else skipped++;
    if (set_name(base + 0xC2EBE, "D2CLIENT_buf_overflow", 0x880)) renamed++; else skipped++;
    if (set_name(base + 0xC2FD6, "D2CLIENT_vsnprintf", 0x880)) renamed++; else skipped++;
    if (set_name(base + 0xC3717, "D2CLIENT_putchar_buf", 0x880)) renamed++; else skipped++;
    if (set_name(base + 0xC37B5, "D2CLIENT_va_arg_int", 0x880)) renamed++; else skipped++;
    if (set_name(base + 0xC42A0, "D2CLIENT_strlen", 0x880)) renamed++; else skipped++;
    if (set_name(base + 0xC2E48, "D2CLIENT_format_float", 0x880)) renamed++; else skipped++;
    if (set_name(base + 0xB7BC0, "CURSOR_GetMouseX", 0x880)) renamed++; else skipped++;
    if (set_name(base + 0xB7BD0, "CURSOR_GetMouseY", 0x880)) renamed++; else skipped++;
    if (set_name(base + 0xB370, "GAME_Main", 0x880)) renamed++; else skipped++;
    if (set_name(base + 0xA3B0, "GAME_OpenServerThread", 0x880)) renamed++; else skipped++;
    if (set_name(base + 0x9AF0, "GAME_InGameTick", 0x880)) renamed++; else skipped++;
