    if (set_name(base + 0x88020, "UNIT_AllocateGlobalTables", 0x880)) renamed++; else skipped++;
    if (set_name(base + 0x897F0, "UNIT_GetUnitName", 0x880)) renamed++; else skipped++;

    Message("[D2Client] Renamed: %d ok, %d skipped/failed\n", renamed, skipped);
}

